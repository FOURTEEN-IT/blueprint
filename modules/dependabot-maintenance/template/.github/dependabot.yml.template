# Versionsupdates fuer alle Oekosysteme im Repo. Der Commit-Typ "chore" ist
# bewusst gewaehlt: er loest laut Semantic Release (siehe Modul
# deployment-fly) keinen Release aus -- eine Abhaengigkeit zu
# bumpen soll nicht automatisch deployen. github-actions bekommt "ci", weil
# das die ueblichere Betreffzeile fuer Workflow-Aenderungen ist.
#
# minor/patch-Updates werden je Oekosystem zu einer PR gebuendelt, damit die
# Zahl der PRs beherrschbar bleibt; major-Updates bleiben einzeln, weil sie
# eher brechende Aenderungen tragen und einzeln geprueft werden sollten.
#
# {{DEPENDABOT_ECOSYSTEMS}}: Diese Vorlage listet "gradle" und
# "github-actions" -- die beiden, die aus backend-java-onion/
# deployment-fly sicher vorhanden sind. Ist frontend-react-vite
# gewaehlt, den npm-Block fuer /frontend ergaenzen (siehe unten,
# auskommentiert). Weitere Verzeichnisse mit eigenem package.json
# (z. B. /e2e) bekommen denselben Block je einmal.
version: 2
updates:
  - package-ecosystem: "gradle"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
    commit-message:
      prefix: "chore"
    labels:
      - "dependencies"
      - "java"
    groups:
      minor-und-patch:
        update-types:
          - "minor"
          - "patch"

  # Nur mit Modul frontend-react-vite -- sonst diesen Block entfernen.
  # - package-ecosystem: "npm"
  #   directory: "/frontend"
  #   schedule:
  #     interval: "weekly"
  #   open-pull-requests-limit: 10
  #   commit-message:
  #     prefix: "chore"
  #   labels:
  #     - "dependencies"
  #     - "frontend"
  #   groups:
  #     minor-und-patch:
  #       update-types:
  #         - "minor"
  #         - "patch"

  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
    commit-message:
      prefix: "ci"
    labels:
      - "dependencies"
      - "github-actions"
    groups:
      minor-und-patch:
        update-types:
          - "minor"
          - "patch"
