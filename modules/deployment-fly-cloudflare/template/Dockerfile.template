# Multi-Stage-Build: Frontend bauen, Backend bauen, schlankes Runtime-Image.
# Vorbild: Referenzimplementierung (Dockerfile). Anpassen an den tatsaechlich gewaehlten
# Backend-Baustein (dieses Beispiel: Gradle/Java) und Frontend-Baustein
# (dieses Beispiel: Node/Vite) -- Platzhalter markieren, was projektspezifisch
# ist.

# --- Frontend bauen (nur falls ein separates Frontend existiert) ----------
FROM node:{{NODE_VERSION}}-alpine AS frontend
WORKDIR /frontend
COPY {{FRONTEND_DIR}}/package.json {{FRONTEND_DIR}}/package-lock.json* ./
RUN npm install
COPY {{FRONTEND_DIR}}/ ./
RUN npm run build

# --- Backend bauen ----------------------------------------------------------
FROM gradle:{{GRADLE_IMAGE_TAG}} AS backend
WORKDIR /app
COPY settings.gradle.kts build.gradle.kts ./
COPY src ./src
# Das Frontend ist im vorigen Schritt schon gebaut, daher hier ueberspringen.
COPY --from=frontend /frontend/dist ./src/main/resources/static
RUN gradle bootJar --no-daemon -P{{SKIP_FRONTEND_GRADLE_PROPERTY}}

# --- Laufzeit ---------------------------------------------------------------
FROM eclipse-temurin:{{JRE_IMAGE_TAG}}
WORKDIR /app
COPY --from=backend /app/build/libs/*.jar app.jar
EXPOSE {{APP_PORT}}
# MaxRAMPercentage bindet den Heap an das Container-Limit statt an den
# Arbeitsspeicher des Hosts. Ohne das rechnet die JVM auf einer kleinen
# Fly-Maschine daran vorbei und riskiert einen OOM-Kill -- der kostet bei
# einer zustandsbehafteten Anwendung nicht nur den laufenden Request,
# sondern den kompletten In-Memory-Zustand.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
