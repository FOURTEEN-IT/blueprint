#!/usr/bin/env bash
# Echter Git-Hook (kein Claude-Code-Hook): validiert die Commit-Nachricht,
# bevor der Commit entsteht. Wirkt fuer jeden, der hier committet -- Mensch
# oder Agent --, nicht nur waehrend einer Sitzung eines KI-Assistenten.
#
# Aktiv nach einmaligem `git config core.hooksPath .githooks` je Klon --
# .git/hooks liegt ausserhalb der Versionskontrolle, deshalb dieser Umweg
# ueber ein versioniertes Verzeichnis.
#
# Herkunft: aus Watchparty (.githooks/commit-msg) uebernommen, unveraendert
# bis auf den Pfad zum Pruefskript.

set -euo pipefail
exec "$(git rev-parse --show-toplevel)/ci/commit-format-pruefen.sh" "$1"
